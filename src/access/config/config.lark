// Common terminals and rules for use in all ACCESS configuration parsers

// Dictionary keys
key : CNAME

// Fortran logicals
logical: FTRUE | FFALSE
FTRUE: ".true."i
FFALSE: ".false."i

// Booleans
bool: TRUE | FALSE
TRUE: "True"
FALSE: "False"

// Integers
integer: SIGNED_INT

// Floats
float: SIGNED_FLOAT

// Fortran double values
double: SIGNED_DOUBLE
_DOUBLE_EXP    : ("d"|"D") SIGNED_INT
DOUBLE        : INT _DOUBLE_EXP | DECIMAL _DOUBLE_EXP?
SIGNED_DOUBLE : ["+"|"-"] DOUBLE

// Fortran complex floats. Either component may be written as a plain integer.
complex: CMPLX
_CMPLX_PART: SIGNED_FLOAT | SIGNED_INT
CMPLX: "(" WS_INLINE* _CMPLX_PART WS_INLINE* "," WS_INLINE* _CMPLX_PART WS_INLINE* ")"

// Fortran complex doubles
double_complex: DCMPLX
DCMPLX: "(" WS_INLINE* SIGNED_DOUBLE WS_INLINE* "," WS_INLINE* SIGNED_DOUBLE WS_INLINE* ")"

// Identifiers
identifier: CNAME

// Quoted strings
string: STRING
STRING: /(".*?(?<!\\)(\\\\)*?"|'(?!'').*?(?<!\\)(\\\\)*?')/

// Fortran strings, where a quote inside a string is written twice rather than escaped:
// 'it''s' is the five characters "it's". A separate rule from "string" because that
// difference has to reach the value handler, which is chosen by rule name.
fortran_string: FORTRAN_STRING
FORTRAN_STRING: /'([^'\n]|'')*'|"([^"\n]|"")*"/

// Unix-like filesystem paths
path: PATH
PATH_COMPONENT : /[a-zA-Z0-9._-]+/
PATH           : ("/" | "./" | "../")? PATH_COMPONENT ("/" PATH_COMPONENT)* ("/")?

// A line of free text: everything up to a comment or the end of the line, without the
// whitespace on either side. A line starting with "::" is never one, since in an ESMF
// resource file that closes a table.
text_line: TEXT_LINE
TEXT_LINE: /(?!::)[^\s#](?:[^\r\n#]*[^\s#])?/

// Values the FMS field manager types by their spelling, holding nothing it splits on: no
// comma, no equals sign. In double quotes, or bare, where it may not end with the "/"
// that would end a field table entry.
inferred_string: INFERRED_STRING
INFERRED_STRING: /"[^"\r\n,=]+"/
inferred_text: INFERRED_TEXT
INFERRED_TEXT: /[^\s"=,][^"\r\n=,]*[^\s"=,\/]|[^\s"=,\/]/

// A name and a control of comma-separated parameters, read as one record:
// "fixed", "surface_value=1.e30".
named_assignments: NAMED_ASSIGNMENTS
NAMED_ASSIGNMENTS: /"[^"\r\n]*"[ \t]*,[ \t]*"[^"\r\n]*=[^"\r\n]*"/

// Space, newlines and comments
ws: WS_INLINE
NEWLINE: CR? LF
comment: /[ \t]*#[^\n]*/
fortran_comment: /[ \t]*![^\n]*/

%import common.CNAME
%import common.SIGNED_INT
%import common.SIGNED_FLOAT
%import common.INT
%import common.DECIMAL
%import common.CR
%import common.LF
%import common.WS_INLINE